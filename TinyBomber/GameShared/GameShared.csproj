<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <PropertyGroup>
      <PluginOutputDirectory Condition="'$(PluginOutputDirectory)' == ''">$(SolutionDir)GameClient\Assets\Plugins</PluginOutputDirectory>
    </PropertyGroup>
    <Exec Command="copy /Y &quot;$(TargetPath)&quot; &quot;$(PluginOutputDirectory)\&quot;" />
  </Target>

</Project>
